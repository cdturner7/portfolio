<configuration>

  <!--
    Console only. Cloud Run, Docker and `mvnw spring-boot:run` all capture stdout/stderr
    straight into their log streams, so a file appender adds nothing - and on Cloud Run
    the container filesystem is read-only apart from /tmp, so writing log files there would
    only fail or waste memory.
  -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{MM-dd-yyyy HH:mm:ss} %-5level %logger{0} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.collindturner" level="DEBUG"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>

</configuration>
